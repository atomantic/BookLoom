<?xml version="1.0" encoding="UTF-8"?>
<!--
  BookLoom-macOS.entitlements — macOS signing entitlements (MANUALLY MAINTAINED)

  XcodeGen cannot generate per-SDK entitlements from project.yml, so this file
  is maintained by hand. It mirrors the CloudKit keys from BookLoom.entitlements
  and adds macOS-only App Sandbox keys required for Mac App Store / TestFlight.

  When shared CloudKit capabilities change, update BOTH:
    - BookLoom/App/BookLoom.entitlements         (iOS, written by XcodeGen)
    - BookLoom/App/BookLoom-macOS.entitlements   (this file, manual)

  DO NOT remove `com.apple.security.app-sandbox` — TestFlight validation rejects
  the upload with "App sandbox not enabled" (error 409).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with iOS — must mirror BookLoom.entitlements for CloudKit -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.net.shadowpuppet.PlotLoom</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- macOS App Sandbox — required for Mac App Store / TestFlight -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
